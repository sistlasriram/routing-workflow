    {
      "parameters": {
        "inputText": "={{ $json.snippet }}",
        "categories": {
          "categories": [
            {
              "category": "high priority",
              "description": " You are an Email Classification agent specialized in identifying HIGH PRIORITY emails. Classify an email as High Priority if it meets ANY of the following conditions: Requires immediate action or response Mentions account suspension, security alerts, breaches, legal notices, payments failures, deadlines, or urgent warnings Comes from trusted platforms (banks, cloud providers, government, legal entities) Contains words like: urgent, immediate action required, suspended, blocked, failed payment, security alert, violation, deadline DO NOT classify marketing, newsletters, or general inquiries as High Priority. Output Format: Category: High Priority"
            },
            {
              "category": "customer support",
              "description": "You are an Email Classification agent specialized in identifying CUSTOMER SUPPORT emails. Classify an email as Customer Support if it: Is a response to a user inquiry, ticket, or complaint Contains case IDs, ticket numbers, reference numbers Provides help, troubleshooting steps, or status updates Uses language such as: support, help, ticket, case, request, issue, resolved, follow-up Emails may be automated or human-written. DO NOT classify promotional or sales emails as Customer Support. Output Format: Category: Customer Support Confidence: High / Medium / Low Reason: Brief explanation identifying support-related content"
            },
            {
              "category": "business",
              "description": "You are an Email Classification agent specialized in identifying BUSINESS emails. Classify an email as Business if it: Relates to professional communication, partnerships, meetings, contracts, invoices, proposals, or internal coordination Is informational or operational rather than promotional Includes scheduling, project updates, documentation, or formal communication Uses professional tone without marketing or urgency DO NOT classify urgent alerts as High Priority or marketing emails as Promotions. Output Format: Category: Business Confidence: High / Medium / Low Reason: Brief explanation of business relevance"
            },
            {
              "category": "promotion",
              "description": "You are an Email Classification agent specialized in identifying PROMOTIONAL emails. Classify an email as Promotions if it meets ANY of the following conditions: Advertises products, services, offers, discounts, or special deals. Contains coupons, promo codes, cashback offers, or seasonal sales. Promotes marketing campaigns, product launches, or limited-time offers. Includes newsletters primarily intended to advertise products, services, or commercial offers. Encourages purchases, subscriptions, upgrades, or participation in promotional campaigns."
            }
          ]
        },
        "options": {}
